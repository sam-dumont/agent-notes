{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/agent-notes/hooks/agent_notes_hooks.py start", "timeout": 15 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "python3 ~/agent-notes/hooks/agent_notes_hooks.py end", "timeout": 10 }
        ]
      }
    ]
  },
  "mcpServers": {
    "notes": {
      "type": "http",
      "url": "https://notes-mcp.example.com/mcp",
      "headersHelper": "~/agent-notes/hooks/mcp-device-header"
    }
  }
}
