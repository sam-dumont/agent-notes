# agent-notes, Docker Compose. Copy to .env (mode 600), then run
# ../../scripts/init-env.sh .env to fill the random secrets. Never commit .env.

# Profiles: edge (TLS here; drop it if your own proxy terminates TLS),
# web (Obsidian in a browser), github-app (short-lived GitHub tokens).
COMPOSE_PROFILES=edge

# --- Hostnames (DNS A/AAAA records pointing at this machine) ----------------
SYNC_HOST=sync.example.com
MCP_HOST=notes-mcp.example.com
WEB_HOST=obsidian.example.com
ACME_EMAIL=

# --- OIDC (docs/oidc.md) ------------------------------------------------------
# One confidential client (authorization code). Redirect URIs to register:
#   https://<MCP_HOST>/auth/callback
#   https://<MCP_HOST>/elevate/callback
#   https://<WEB_HOST>/oauth2/callback       (profile web)
OIDC_ISSUER=https://idp.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Only for providers that issue JWT access tokens for an API (Auth0):
OIDC_AUDIENCE=
# Your `sub` at the provider: the only account the MCP server serves.
AGENT_NOTES_ALLOWED_SUBS=
# What proves a fresh second factor on the approval page (docs/oidc.md).
AGENT_NOTES_STRONG_AMR=mfa,phr,phrh
AGENT_NOTES_STRONG_ACR=
AGENT_NOTES_ACR_VALUES=
AGENT_NOTES_METHODS_CLAIM=
# The one email allowed into Obsidian in a browser (profile web).
WEB_ALLOWED_EMAIL=

# --- Git remote (docs/git.md) -------------------------------------------------
# HTTPS with a token file, or SSH with a key and a known_hosts file, both
# under secrets/git/ (mounted at /secrets/git). On Linux, chown them to 1000
# (git-sync's uid) and keep them mode 600 (docs/git.md).
GIT_REMOTE=https://github.com/you/notes.git
GIT_BRANCH=main
GIT_TOKEN_FILE=/secrets/git/token
GIT_SSH_KEY=
GIT_SSH_KNOWN_HOSTS=
# profile github-app: GIT_TOKEN_FILE=/run/git/token, key in secrets/git/github-app.pem
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_REPO=

# --- Access policy (docs/security.md) -----------------------------------------
AGENT_NOTES_WRITE_PREFIXES=inbox/
AGENT_NOTES_APPEND_PREFIXES=inbox/
AGENT_NOTES_PRIVATE_PREFIXES=
AGENT_NOTES_RULES_PATH=agents/digest.md
# Trust clients registered with loopback redirects only (Claude Code on a
# laptop)? Off: a loopback redirect can't prove which local program is
# listening. Enroll the machine instead (next line). 1 to turn it on.
AGENT_NOTES_TRUST_LOOPBACK=
# Enrolled machines, trusted without elevation: {"kid": "PEM", ...} (docs/devices.md)
AGENT_NOTES_DEVICE_KEYS=

# --- Sync ----------------------------------------------------------------------
COUCHDB_DATABASE=notes
JWT_SUB=owner

# --- Secrets: filled by scripts/init-env.sh, never by hand ---------------------
COUCHDB_UUID=
COUCHDB_ADMIN_PASSWORD=
COUCHDB_COOKIE_SECRET=
LIVESYNC_PASSWORD=
E2E_PASSPHRASE=
AGENT_NOTES_JWT_SIGNING_KEY=
AGENT_NOTES_STORAGE_KEY=
OAUTH2_PROXY_COOKIE_SECRET=
